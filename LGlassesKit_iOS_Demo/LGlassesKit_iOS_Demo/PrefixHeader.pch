#ifndef PrefixHeader_pch
#define PrefixHeader_pch

// Include any system framework and library headers here that should be included in all compilation units.
// You will also need to set the Prefix Header build setting of one or more of your targets to reference this file.

/// 弱引用
#define LWEAKSELF                           __weak typeof(self) weakSelf = self;

/// 屏幕宽度，会根据横竖屏的变化而变化
#define SCREEN_WIDTH ([[UIScreen mainScreen] bounds].size.width)

/// 屏幕高度，会根据横竖屏的变化而变化
#define SCREEN_HEIGHT ([[UIScreen mainScreen] bounds].size.height)

/// 字符串是否为空
#define IF_NULL(string)                     (( ![string isKindOfClass:[NSString class]]) || (string == nil) || [string isEqualToString:@""] || [string isKindOfClass:[NSNull class]] || [string stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]].length == 0)

/// 字符串防空处理
#define IF_NULL_TO_STRING(string)           (IF_NULL(string) ? @"" : string)

/// 图片
#define UIImageMake(icon)                   [UIImage imageNamed:icon]

/// GCD主队列(主线程执行)
#define GCD_MAIN_QUEUE(block)               dispatch_async(dispatch_get_main_queue(), block)

/// 字体-细
#define UIFontMake(size)                    [UIFont systemFontOfSize:size]
/// 字体-粗
#define UIFontBoldMake(size)                [UIFont boldSystemFontOfSize:size]

/// 字体颜色
#define LTextColor                          [LColor textColor]

/// 颜色RGB
#define UIColorMakeWithRGBA(r, g, b, a)     [UIColor colorWithRed:r/255.0 green:g/255.0 blue:b/255.0 alpha:a/1.0]

/// 文件缓存的目标文件夹 (NSURL)
#define LCacheDirectoryURL                  [[NSFileManager defaultManager] URLForDirectory:NSCachesDirectory inDomain:NSUserDomainMask appropriateForURL:nil create:YES error:nil]


// 三方SDK
#import <Masonry/Masonry.h>
#import <Realm/Realm.h>
#import <SVProgressHUD/SVProgressHUD.h>
#include <libopus/libopus-umbrella.h>
#import <MJExtension/MJExtension-umbrella.h>

// 眼镜👓SDK
#import <LGlassesKit_iOS/LGlassesKit_iOS.h>
// AI🤖SDK
#import <iOS_LWAIGCKit/iOS_LWAIGCKit.h>

#import "LCommonNavigationController.h"
#import "LAIGC.h"
#import "LNetworkManage.h"
#import "LMainViewController.h"
#import "ATools.h"
#import "RLMDeviceModel.h"
#import "RLMOtaDeviceModel.h"
#import "RLMObject+Tools.h"
#import "LHUD.h"
#import "LColor.h"

#endif /* PrefixHeader_pch */
